# Local development only. Never put a real token in Git.
EXPO_PUBLIC_APP_CHECK_PROVIDER=debug
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=

# Local path used by app.config.js. EAS stores this as a file variable instead.
GOOGLE_SERVICES_JSON=./google-services.json

# Public client configuration. These values are safe in the compiled app, but
# each environment must point to its matching Firebase/RevenueCat/Play project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_PLAY_INTEGRITY_PROJECT_NUMBER=

# Backend deployment switches. Configure these in the Functions deployment
# environment; never enable Play enforcement before Play Integrity telemetry is healthy.
PROFU_RELEASE_SECURITY_STAGE=pre-play-public
PROFU_ENABLE_REVENUECAT=false
