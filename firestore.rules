rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/_accountLifecycle/$(userId));
    }

    function validStudyTrack(value) {
      return value in ['gimnaziu', 'en', 'liceu', 'bac_m1', 'bac_m2', 'bac_m3'];
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'createdAt',
          'updatedAt',
          'displayName',
          'grade',
          'studyTrack',
          'onboardingCompleted'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('displayName' in data)
          || (data.displayName is string && data.displayName.size() <= 40))
        && (!('grade' in data)
          || (data.grade is int && data.grade >= 5 && data.grade <= 12))
        && (!('studyTrack' in data)
          || (data.studyTrack is string && validStudyTrack(data.studyTrack)))
        && (!('onboardingCompleted' in data)
          || data.onboardingCompleted is bool);
    }

    function validExamRecord(record) {
      return record is map
        && record.keys().hasOnly([
          'id',
          'variantId',
          'examId',
          'scope',
          'completedAt',
          'awardedPoints',
          'maxPoints',
          'grade',
          'elapsedSeconds',
          'subjectPoints',
          'pauseCount'
        ])
        && record.id is string && record.id.size() >= 1 && record.id.size() <= 64
        && record.variantId is string && record.variantId.size() >= 1 && record.variantId.size() <= 64
        && record.examId is string && record.examId in ['en', 'bac_m1', 'bac_m2', 'bac_m3']
        && record.scope is string && record.scope in ['full', 's1', 's2', 's3']
        && record.completedAt is string && record.completedAt.size() >= 10 && record.completedAt.size() <= 40
        && record.awardedPoints is number && record.awardedPoints >= 0 && record.awardedPoints <= 100
        && record.maxPoints is number && record.maxPoints >= 1 && record.maxPoints <= 100
        && record.awardedPoints <= record.maxPoints
        && (record.grade == null || (record.grade is number && record.grade >= 1 && record.grade <= 10))
        && record.elapsedSeconds is number && record.elapsedSeconds >= 0 && record.elapsedSeconds <= 86400
        && record.subjectPoints is map
        && record.subjectPoints.keys().hasOnly(['s1', 's2', 's3'])
        && record.subjectPoints.s1 is number && record.subjectPoints.s1 >= 0 && record.subjectPoints.s1 <= 100
        && record.subjectPoints.s2 is number && record.subjectPoints.s2 >= 0 && record.subjectPoints.s2 <= 100
        && record.subjectPoints.s3 is number && record.subjectPoints.s3 >= 0 && record.subjectPoints.s3 <= 100
        && (!('pauseCount' in record) || (record.pauseCount is int && record.pauseCount >= 0 && record.pauseCount <= 500));
    }

    function validStudyProgress(data) {
      return data.keys().hasOnly([
          'track',
          'hasChosenTrack',
          'favoriteFormulaIds',
          'exploredFormulaIds',
          'masteredQuestionIds',
          'wrongQuestionIds',
          'streakDays',
          'lastPracticeDateKey',
          'sessionsCompleted',
          'totalAnswered',
          'totalCorrect',
          'examRecords',
          'updatedAt'
        ])
        && data.track is string && validStudyTrack(data.track)
        && data.hasChosenTrack is bool
        && data.favoriteFormulaIds is list && data.favoriteFormulaIds.size() <= 100
        && data.exploredFormulaIds is list && data.exploredFormulaIds.size() <= 120
        && data.masteredQuestionIds is list && data.masteredQuestionIds.size() <= 250
        && data.wrongQuestionIds is list && data.wrongQuestionIds.size() <= 120
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650
        && (data.lastPracticeDateKey == null
          || (data.lastPracticeDateKey is string && data.lastPracticeDateKey.size() == 10))
        && data.sessionsCompleted is int && data.sessionsCompleted >= 0 && data.sessionsCompleted <= 100000
        && data.totalAnswered is int && data.totalAnswered >= 0 && data.totalAnswered <= 1000000
        && data.totalCorrect is int && data.totalCorrect >= 0 && data.totalCorrect <= data.totalAnswered
        && (!('examRecords' in data)
          || (data.examRecords is list
            && data.examRecords.size() <= 24
            && (data.examRecords.size() == 0 || validExamRecord(data.examRecords[0]))))
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if owns(userId);

      match /studyProgress/{docId} {
        allow get: if owns(userId) && docId == 'summary';
        allow list: if false;
        allow create, update: if owns(userId)
          && docId == 'summary'
          && validStudyProgress(request.resource.data);
        allow delete: if owns(userId) && docId == 'summary';
      }

      match /lessons/{lessonId} {
        // Soluția și verdictul sunt create numai de backendul de încredere.
        allow read: if owns(userId);
        allow create: if false;
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isFavorite', 'userTitle', 'expiresAt', 'updatedAt'])
          && ('isFavorite' in request.resource.data)
          && request.resource.data.isFavorite is bool
          && (!('userTitle' in request.resource.data)
            || (request.resource.data.userTitle is string
              && request.resource.data.userTitle.size() <= 80))
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && ((request.resource.data.isFavorite == true
              && request.resource.data.expiresAt <= request.time + duration.value(401, 'd'))
            || (request.resource.data.isFavorite == false
              && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')))
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(userId);
      }
    }

    match /feedback/{feedbackId} {
      // Raportările trec exclusiv prin callable-ul protejat cu App Check și
      // rate limiting. Clienții nu pot scrie sau citi direct colecția.
      allow read, write: if false;
    }

    // Orice colecție care nu este definită explicit rămâne inaccesibilă clienților.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
