rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validProfile(data) {
      return data.keys().hasOnly([
          'createdAt',
          'updatedAt',
          'displayName',
          'grade',
          'onboardingCompleted'
        ])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('displayName' in data)
          || (data.displayName is string && data.displayName.size() <= 40))
        && (!('grade' in data)
          || (data.grade is int && data.grade >= 5 && data.grade <= 12))
        && (!('onboardingCompleted' in data)
          || data.onboardingCompleted is bool);
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;
      allow create: if owns(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owns(userId)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if owns(userId);

      match /lessons/{lessonId} {
        // Soluția și verdictul sunt create numai de backendul de încredere.
        allow read: if owns(userId);
        allow create: if false;
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isFavorite', 'userTitle', 'expiresAt', 'updatedAt'])
          && ('isFavorite' in request.resource.data)
          && request.resource.data.isFavorite is bool
          && (!('userTitle' in request.resource.data)
            || (request.resource.data.userTitle is string
              && request.resource.data.userTitle.size() <= 80))
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && ((request.resource.data.isFavorite == true
              && request.resource.data.expiresAt <= request.time + duration.value(401, 'd'))
            || (request.resource.data.isFavorite == false
              && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')))
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(userId);
      }
    }

    match /feedback/{feedbackId} {
      // Raportările trec exclusiv prin callable-ul protejat cu App Check și
      // rate limiting. Clienții nu pot scrie sau citi direct colecția.
      allow read, write: if false;
    }

    // Orice colecție care nu este definită explicit rămâne inaccesibilă clienților.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
