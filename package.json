{
  "name": "profu-de-mate",
  "version": "1.0.0",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <12"
  },
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/balsamiq-sans": "^0.4.1",
    "@expo-google-fonts/fira-sans": "^0.4.1",
    "@expo/app-integrity": "^57.0.1",
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/app-check": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "@react-native-firebase/functions": "^26.4.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "expo": "~57.0.20",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.14",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-navigation-bar": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-google-signin": "^2.1.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-purchases": "10.9.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase": "^12.18.0",
    "firebase-tools": "15.29.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "npm run dev:phone",
    "dev:phone": "npm run env:sync:development && npm run dev:phone:local",
    "dev:phone:local": "node scripts/validate-client-env.cjs development && expo start --dev-client --lan",
    "env:sync:development": "npx --yes eas-cli@22.2.0 env:pull development --path .env.local --non-interactive",
    "env:check:development": "npx --yes eas-cli@22.2.0 env:exec development \"node scripts/validate-client-env.cjs development\"",
    "env:check:preview": "npx --yes eas-cli@22.2.0 env:exec preview \"node scripts/validate-client-env.cjs preview\"",
    "env:check:production": "npx --yes eas-cli@22.2.0 env:exec production \"node scripts/validate-client-env.cjs production\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "deps:check": "expo install --check",
    "lint": "expo lint",
    "check": "tsc --noEmit && npm run deps:check && npm run lint && npx expo-doctor",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "deploy:firebase": "node scripts/deploy-firebase.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:mobile": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts",
    "legal:check": "node scripts/validate-legal.mjs",
    "release:bundle-check": "node scripts/verify-production-bundle.mjs",
    "test:rules": "npm --prefix functions run build && firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.mjs && node --test functions/integration/commercialAccess.test.mjs\""
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  },
  "private": true
}
