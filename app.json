{
  "expo": {
    "name": "Profu’ de mate",
    "slug": "profu-de-mate",
    "version": "1.0.0",
    "platforms": [
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-v2.png",
    "scheme": "profudemate",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5218D2",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ro.profudemate.app",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#171337",
        "foregroundImage": "./assets/brand/adaptive-foreground-v2.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon-v2.png"
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/balsamiq-sans/400Regular/BalsamiqSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/balsamiq-sans/700Bold/BalsamiqSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/fira-sans/400Regular/FiraSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/fira-sans/500Medium/FiraSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/fira-sans/600SemiBold/FiraSans_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite aplicației „Profu’ de mate” să folosească camera pentru a fotografia problema sau rezolvarea.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite aplicației „Profu’ de mate” să aleagă fotografia unei probleme sau rezolvări.",
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ],
      [
        "expo-asset",
        {
          "assets": [
            "./assets/icons",
            "./assets/mascot",
            "./assets/brand/splash_mark_v2.png",
            "./assets/brand/profu_mark_v2.png",
            "./assets/profu_mascot_v2.png"
          ]
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "787d3089-788a-4b3f-b4dd-9096a08a1ea2"
      }
    },
    "owner": "matdan88"
  }
}
