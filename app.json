{
  "expo": {
    "name": "Profu’ de mate",
    "slug": "profu-de-mate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-v2.png",
    "scheme": "profudemate",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7E7",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "ro.profudemate.app",
      "versionCode": 1,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#171337",
        "foregroundImage": "./assets/brand/adaptive-foreground-v2.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome-v2.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon-v2.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Permite aplicației „Profu’ de mate” să folosească camera pentru a fotografia problema sau rezolvarea.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite aplicației „Profu’ de mate” să aleagă fotografia unei probleme sau rezolvări.",
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": true,
          "style": "light"
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "enforceContrast": false,
        "style": "light",
        "hidden": true
      },
      "eas": {
        "projectId": "787d3089-788a-4b3f-b4dd-9096a08a1ea2"
      }
    },
    "owner": "matdan88"
  }
}
