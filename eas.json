{
  "cli": {
    "version": ">= 22.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.20.0",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_CHECK_PROVIDER": "debug"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "22.20.0",
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_CHECK_PROVIDER": "debug"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "node": "22.20.0",
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_CHECK_PROVIDER": "none"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.20.0",
      "autoIncrement": true,
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
